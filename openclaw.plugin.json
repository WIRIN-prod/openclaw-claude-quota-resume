{
  "id": "claude-quota-resume",
  "name": "Claude Quota Resume",
  "description": "Queues original prompts after Claude subscription quota errors and schedules retries at detected reset times.",
  "version": "0.3.1",
  "configSchema": {
    "type": "object",
    "properties": {
      "statePath": {
        "type": "string"
      },
      "defaultSessionKey": {
        "type": "string"
      },
      "initialRetryMs": {
        "type": "number",
        "minimum": 1000
      },
      "retryOnUnknownFailure": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
